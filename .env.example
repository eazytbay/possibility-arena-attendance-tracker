SECRET_KEY=change-me-use-a-long-random-string
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://attendance:change-me@db:5432/attendance
CHURCH_NAME=Our Church
PUBLIC_BASE_URL=https://attendance.enobsai.com
SESSION_COOKIE_SECURE=true

# SMS greetings (birthday + new month). Off by default.
SMS_ENABLED=false
SMS_API_TOKEN=
SMS_SENDER_ID=
SMS_GATEWAY=direct-corporate

# A visitor becomes a member after this many Sundays attended (0 = never)
VISITOR_PROMOTE_AFTER=4

# Age groups that get a pickup code (older children check in without one)
PICKUP_CODE_AGE_GROUPS=0-2,3-5

# Absence lists: a regular came at least once in the last N Sundays; missed-in-a-row length
ABSENT_LOOKBACK=8
MISSED_IN_A_ROW=3
